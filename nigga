-- 2. Aimbot ล็อคเป้า
local function GetPartName()
    if Settings.AimPart == "ลำตัว" then return "HumanoidRootPart" end
    if Settings.AimPart == "ขา" then return "RightLowerLeg" end
    return "Head"
end

local function IsVisible(targetPart)
    if not Settings.WallCheck then return true end
    local parts = Camera:GetPartsObscuringTarget({Camera.CFrame.Position, targetPart.Position}, {LocalPlayer.Character, targetPart.Parent})
    return #parts == 0
end

RunService.RenderStepped:Connect(function()
    if Settings.Aimbot and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local target, dist = nil, Settings.FOVSize
        local mPos = Settings.FOVMode == "ตามเมาส์" and UserInputService:GetMouseLocation() or Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        
        local function CheckEntity(char, isPlayer)
            if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                local part = char:FindFirstChild(GetPartName()) or char:FindFirstChild("Head")
                if part and IsVisible(part) then
                    local sPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local d = (Vector2.new(sPos.X, sPos.Y) - mPos).Magnitude
                        if d < dist then
                            dist = d
                            target = part
                        end
                    end
                end
            end
        end

        if Settings.AimTarget == "ผู้เล่น" or Settings.AimTarget == "ทั้งหมด" then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and (not Settings.TeamCheck or p.Team ~= LocalPlayer.Team) then
                    CheckEntity(p.Character, true)
                end
            end
        end
        if Settings.AimTarget == "NPC" or Settings.AimTarget == "ทั้งหมด" then
            for _, obj in pairs(workspace:GetChildren()) do
                if obj:IsA("Model") and not Players:GetPlayerFromCharacter(obj) then
                    CheckEntity(obj, false)
                end
            end
        end

        if target then
            if Settings.Smoothness <= 1 then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
            else
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, target.Position), 1/Settings.Smoothness)
            end
        end
    end
end)

-- 3. ESP แบบเรืองแสง (Highlight)
RunService.RenderStepped:Connect(function()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local hl = char:FindFirstChild("ProESP_Highlight")
            
            if Settings.ESP then
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "ProESP_Highlight"
                    hl.Parent = char
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0
                end
                if Settings.ESPRainbow then
                    hl.FillColor = Color3.fromHSV(tick()%5/5, 1, 1)
                    hl.OutlineColor = Color3.new(1,1,1)
                else
                    hl.FillColor = Color3.fromRGB(255, 0, 0)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                end
                
                -- โชว์ชื่อบนหัว
                local head = char:FindFirstChild("Head")
                if head then
                    local nameTag = head:FindFirstChild("ProESP_Name")
                    if Settings.ESPName then
                        if not nameTag then
                            nameTag = Instance.new("BillboardGui")
                            nameTag.Name = "ProESP_Name"
                            nameTag.Parent = head
                            nameTag.Size = UDim2.new(0, 100, 0, 40)
                            nameTag.StudsOffset = Vector3.new(0, 2, 0)
                            nameTag.AlwaysOnTop = true
                            local txt = Instance.new("TextLabel")
                            txt.Parent = nameTag
                            txt.Size = UDim2.new(1,0,1,0)
                            txt.BackgroundTransparency = 1
                            txt.Text = p.Name
                            txt.TextColor3 = Color3.new(1,1,1)
                            txt.TextStrokeTransparency = 0
                            txt.Font = Enum.Font.SourceSansBold
                            txt.TextSize = 14
                        end
                        nameTag.TextLabel.TextColor3 = Settings.ESPRainbow and Color3.fromHSV(tick()%5/5, 1, 1) or Color3.fromRGB(255,75,75)
                    elseif nameTag then
                        nameTag:Destroy()
                    end
                end
            else
                if hl then hl:Destroy() end
                local head = char:FindFirstChild("Head")
                if head and head:FindFirstChild("ProESP_Name") then head.ProESP_Name:Destroy() end
            end
        end
    end
end)

-- 4. การเคลื่อนที่ต่างๆ (Movement)
RunService.RenderStepped:Connect(function()
    -- TP Walk
    if Settings.TPWalk and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local hum = LocalPlayer.Character.Humanoid
        if hrp and hum.MoveDirection.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (hum.MoveDirection * Settings.TPWalkSpeed)
        end
    end
    -- High Jump
    if Settings.HighJump and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        local hum = LocalPlayer.Character.Humanoid
        if hum:GetState() == Enum.HumanoidStateType.Jumping then
            LocalPlayer.Character.HumanoidRootPart.Velocity = Vector3.new(
                LocalPlayer.Character.HumanoidRootPart.Velocity.X,
                Settings.HighJumpPower,
                LocalPlayer.Character.HumanoidRootPart.Velocity.Z
            )
        end
    end
end)

UserInputService.JumpRequest:Connect(function()
    if Settings.InfJump and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

RunService.Stepped:Connect(function()
    if Settings.Noclip and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end
end)
